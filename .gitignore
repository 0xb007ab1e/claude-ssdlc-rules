# Allowlist policy: ~/.claude holds secrets (.credentials.json, history.jsonl,
# sessions/, daemon logs). Ignore EVERYTHING, then track only the SSDLC ruleset.
/*
!/.gitignore
!/CLAUDE.md
!/RTK.md
!/rules/
!/.github/
!/skills/
!/agents/
!/workflows/
!/hooks/
!/scripts/

# Belt-and-suspenders: never track these even if a rule above is loosened.
.credentials.json
.claude_session_key
__pycache__/
*.pyc
history.jsonl
*.log
sessions/
session-env/
projects/
