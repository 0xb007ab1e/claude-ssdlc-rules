# Allowlist policy: ~/.claude holds secrets (.credentials.json, history.jsonl,
# sessions/, daemon logs). Ignore EVERYTHING, then track only the SSDLC ruleset.
/*
!/.gitignore
!/CLAUDE.md
!/RTK.md
!/rules/
!/.github/
!/skills/
!/agents/
!/workflows/
!/hooks/
!/scripts/
!/docs/

# Skills: track only first-party skill dirs. The rest are symlinks into ~/.agents/skills
# (dangling for anyone else) or the auto-synced vendor tree (large, generated) — don't commit.
/skills/synced/
/skills/brandkit
/skills/design-taste-frontend
/skills/design-taste-frontend-v1
/skills/full-output-enforcement
/skills/gpt-taste
/skills/high-end-visual-design
/skills/image-to-code
/skills/imagegen-frontend-mobile
/skills/imagegen-frontend-web
/skills/industrial-brutalist-ui
/skills/minimalist-ui
/skills/redesign-existing-projects
/skills/stitch-design-taste

# Belt-and-suspenders: never track these even if a rule above is loosened.
.credentials.json
.claude_session_key
__pycache__/
*.pyc
history.jsonl
*.log
sessions/
session-env/
projects/
